{
    // For more information, visit: https://go.microsoft.com/fwlink/?LinkId=733558
    "version": "2.0.0",
    "tasks": [
        {
            "type": "npm",
            "script": "start",
            "path": "web",
            "label": "npm: start (web)",
            "isBackground": true,
            "problemMatcher": {
                "owner": "typescript",
                "pattern": "$tsc",
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": {
                        "regexp": "Changes detected"
                    },
                    "endsPattern": {
                        "regexp": "bundle generation (complete|failed)"
                    }
                }
            }
        },
        {
            "type": "npm",
            "script": "test",
            "path": "web",
            "label": "npm: test (web)",
            "isBackground": true,
            "problemMatcher": {
                "owner": "typescript",
                "pattern": "$tsc",
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": {
                        "regexp": "Changes detected"
                    },
                    "endsPattern": {
                        "regexp": "bundle generation (complete|failed)"
                    }
                }
            }
        },
        {
            "label": "npm: test debug (web)",
            "type": "shell",
            "command": "npm",
            "args": ["test", "--", "--debug", "--watch=true"],
            "options": {
                "cwd": "${workspaceFolder}/web"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "typescript",
                "pattern": "$tsc",
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^> ng test.*--debug",
                    "endsPattern": "^Debugger listening on ws://127\\.0\\.0\\.1:9229/"
                }
            }
        }
    ]
}
