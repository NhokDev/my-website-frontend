{
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "ng serve",
            "type": "chrome",
            "request": "launch",
            "preLaunchTask": "npm: start (web)",
            "webRoot": "${workspaceFolder}/web",
            "url": "http://localhost:4200/"
        },
        {
            "name": "ng test",
            "type": "node",
            "request": "attach",
            "preLaunchTask": "npm: test debug (web)",
            "address": "127.0.0.1",
            "port": 9229,
            "cwd": "${workspaceFolder}/web",
            "sourceMaps": true,
            "skipFiles": ["<node_internals>/**", "${workspaceFolder}/web/node_modules/**"]
        }
    ]
}
